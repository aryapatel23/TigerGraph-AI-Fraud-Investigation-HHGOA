CREATE VERTEX Customer (PRIMARY_ID customer_id STRING, customer_id STRING DEFAULT "", created_at DATETIME DEFAULT "1970-01-01 00:00:00") WITH primary_id_as_attribute="true"

CREATE VERTEX Card (PRIMARY_ID card_id STRING, card_id STRING DEFAULT "", card1 INT DEFAULT 0, card2 FLOAT DEFAULT 0.0, card3 FLOAT DEFAULT 0.0, card4 STRING DEFAULT "", card5 FLOAT DEFAULT 0.0, card6 STRING DEFAULT "", addr1 FLOAT DEFAULT 0.0, addr2 FLOAT DEFAULT 0.0, created_at DATETIME DEFAULT "1970-01-01 00:00:00") WITH primary_id_as_attribute="true"

CREATE VERTEX Transaction (PRIMARY_ID transaction_id STRING, transaction_id STRING DEFAULT "", transaction_dt INT DEFAULT 0, transaction_amt FLOAT DEFAULT 0.0, ts DATETIME DEFAULT "1970-01-01 00:00:00", product_cd STRING DEFAULT "", channel STRING DEFAULT "", risk_score FLOAT DEFAULT 0.0, p_emaildomain STRING DEFAULT "", r_emaildomain STRING DEFAULT "", dist1 FLOAT DEFAULT 0.0, dist2 FLOAT DEFAULT 0.0, counts_json STRING DEFAULT "{}", deltas_json STRING DEFAULT "{}", match_flags_json STRING DEFAULT "{}", vesta_features_json STRING DEFAULT "{}") WITH primary_id_as_attribute="true"

CREATE VERTEX DeviceProfile (PRIMARY_ID device_profile_id STRING, device_profile_id STRING DEFAULT "", device_type STRING DEFAULT "", device_info STRING DEFAULT "", os STRING DEFAULT "", browser STRING DEFAULT "", screen STRING DEFAULT "", match_status STRING DEFAULT "") WITH primary_id_as_attribute="true"

CREATE VERTEX IdentityRecord (PRIMARY_ID identity_id STRING, identity_id STRING DEFAULT "", id_15 STRING DEFAULT "", id_23 STRING DEFAULT "", id_28 STRING DEFAULT "", id_30 STRING DEFAULT "", id_31 STRING DEFAULT "", id_33 STRING DEFAULT "", id_34 STRING DEFAULT "", ratings_json STRING DEFAULT "{}", identity_cat_json STRING DEFAULT "{}") WITH primary_id_as_attribute="true"

CREATE VERTEX BillingRegion (PRIMARY_ID region_code STRING, region_code STRING DEFAULT "", addr2 FLOAT DEFAULT 0.0) WITH primary_id_as_attribute="true"

CREATE VERTEX EmailDomain (PRIMARY_ID domain STRING, domain STRING DEFAULT "", domain_type STRING DEFAULT "") WITH primary_id_as_attribute="true"

CREATE VERTEX FraudPattern (PRIMARY_ID pattern_code STRING, pattern_code STRING DEFAULT "", description STRING DEFAULT "", policy_rules STRING DEFAULT "") WITH primary_id_as_attribute="true"

CREATE VERTEX FraudCase (PRIMARY_ID case_id STRING, case_id STRING DEFAULT "", case_source STRING DEFAULT "", customer_id STRING DEFAULT "", card_id STRING DEFAULT "", opened_at DATETIME DEFAULT "1970-01-01 00:00:00", closed_at DATETIME DEFAULT "1970-01-01 00:00:00", status STRING DEFAULT "", outcome STRING DEFAULT "", pattern_code STRING DEFAULT "", first_fraud_txn_id STRING DEFAULT "", txn_ids STRING DEFAULT "", n_txns INT DEFAULT 0, exposure_usd FLOAT DEFAULT 0.0, connected_card_ids STRING DEFAULT "", actions_taken STRING DEFAULT "", report_filed STRING DEFAULT "", analyst_notes STRING DEFAULT "", trigger_type STRING DEFAULT "", trigger_text STRING DEFAULT "", flagged_txn_id STRING DEFAULT "", trigger_risk_score FLOAT DEFAULT 0.0, agent_verdict STRING DEFAULT "", agent_fraud_probability FLOAT DEFAULT 0.0, agent_pattern_description STRING DEFAULT "", agent_summary STRING DEFAULT "", agent_stop_reason STRING DEFAULT "", agent_tool_calls INT DEFAULT 0, written_to_graph BOOL DEFAULT FALSE) WITH primary_id_as_attribute="true"

CREATE VERTEX Evidence (PRIMARY_ID evidence_id STRING, evidence_id STRING DEFAULT "", case_id STRING DEFAULT "", claim STRING DEFAULT "", source STRING DEFAULT "", ref STRING DEFAULT "", entity_ids STRING DEFAULT "") WITH primary_id_as_attribute="true"

CREATE VERTEX Decision (PRIMARY_ID decision_id STRING, decision_id STRING DEFAULT "", case_id STRING DEFAULT "", action STRING DEFAULT "", route STRING DEFAULT "", reason STRING DEFAULT "", phase STRING DEFAULT "", executed BOOL DEFAULT FALSE) WITH primary_id_as_attribute="true"

CREATE DIRECTED EDGE OWNS (FROM Customer, TO Card) WITH REVERSE_EDGE="OWNED_BY"
CREATE DIRECTED EDGE MADE (FROM Card, TO Transaction) WITH REVERSE_EDGE="MADE_BY"
CREATE DIRECTED EDGE FROM_DEVICE (FROM Transaction, TO DeviceProfile) WITH REVERSE_EDGE="DEVICE_USED_IN"
CREATE DIRECTED EDGE HAS_IDENTITY (FROM Transaction, TO IdentityRecord) WITH REVERSE_EDGE="IDENTITY_FOR"
CREATE DIRECTED EDGE BILLED_IN (FROM Transaction, TO BillingRegion) WITH REVERSE_EDGE="HAS_TRANSACTION"
CREATE DIRECTED EDGE USES_EMAIL_DOMAIN (FROM Transaction, TO EmailDomain, domain_role STRING DEFAULT "") WITH REVERSE_EDGE="EMAIL_DOMAIN_USED_IN"
CREATE DIRECTED EDGE NEXT_TXN (FROM Transaction, TO Transaction, gap_seconds INT DEFAULT 0)
CREATE DIRECTED EDGE INVOLVES_TXN (FROM FraudCase, TO Transaction, role STRING DEFAULT "") WITH REVERSE_EDGE="TXN_IN_CASE"
CREATE DIRECTED EDGE ON_CARD (FROM FraudCase, TO Card) WITH REVERSE_EDGE="CARD_IN_CASE"
CREATE DIRECTED EDGE CONNECTED_TO_CARD (FROM FraudCase, TO Card) WITH REVERSE_EDGE="CARD_CONNECTED_IN_CASE"
CREATE DIRECTED EDGE INVOLVES_CUSTOMER (FROM FraudCase, TO Customer) WITH REVERSE_EDGE="CUSTOMER_IN_CASE"
CREATE DIRECTED EDGE LINKED_DEVICE (FROM FraudCase, TO DeviceProfile) WITH REVERSE_EDGE="DEVICE_IN_CASE"
CREATE DIRECTED EDGE MATCHES_PATTERN (FROM FraudCase, TO FraudPattern) WITH REVERSE_EDGE="PATTERN_MATCHED_IN"
CREATE DIRECTED EDGE HAS_EVIDENCE (FROM FraudCase, TO Evidence) WITH REVERSE_EDGE="EVIDENCE_FOR_CASE"
CREATE DIRECTED EDGE HAS_DECISION (FROM FraudCase, TO Decision) WITH REVERSE_EDGE="DECISION_FOR_CASE"
CREATE DIRECTED EDGE SIMILAR_TO_CASE (FROM FraudCase, TO FraudCase, similarity_reason STRING DEFAULT "")

CREATE GRAPH FraudInvestigation (Customer, Card, Transaction, DeviceProfile, IdentityRecord, BillingRegion, EmailDomain, FraudPattern, FraudCase, Evidence, Decision, OWNS, OWNED_BY, MADE, MADE_BY, FROM_DEVICE, DEVICE_USED_IN, HAS_IDENTITY, IDENTITY_FOR, BILLED_IN, HAS_TRANSACTION, USES_EMAIL_DOMAIN, EMAIL_DOMAIN_USED_IN, NEXT_TXN, INVOLVES_TXN, TXN_IN_CASE, ON_CARD, CARD_IN_CASE, CONNECTED_TO_CARD, CARD_CONNECTED_IN_CASE, INVOLVES_CUSTOMER, CUSTOMER_IN_CASE, LINKED_DEVICE, DEVICE_IN_CASE, MATCHES_PATTERN, PATTERN_MATCHED_IN, HAS_EVIDENCE, EVIDENCE_FOR_CASE, HAS_DECISION, DECISION_FOR_CASE, SIMILAR_TO_CASE)
